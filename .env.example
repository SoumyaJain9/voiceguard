# ==============================================================================
# VoxGuard AI - Environment Configuration Variables
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Model Paths
MODEL_PATH=models/best_model.onnx

# Security: Allowed API keys (comma-separated)
API_KEYS=voxguard-demo-key-2026,voxguard-college-eval-key,admin-secret-key

# Temperature Calibration
CALIBRATED_TEMPERATURE=1.362

# Cloud Audit Logging with Supabase (Optional)
# Leave blank to use automatic local SQLite logging in logs/audit_trail.db
SUPABASE_URL=
SUPABASE_KEY=
